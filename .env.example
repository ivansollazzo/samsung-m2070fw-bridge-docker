# Copy to .env and adjust.

# IP (or hostname) of the Samsung Xpress M2070FW. Give it a DHCP reservation!
SCANNER_IP=192.168.1.50
# Network scan port of Samsung MFPs (don't change unless you know why)
SCANNER_PORT=9400

# Shown as the scanner's location ("note") in macOS. Empty = server hostname.
SCANNER_LOCATION=Studio

# AirSane web interface / eSCL port
LISTEN_PORT=8090
# Web UI at http://<server>:LISTEN_PORT/
WEB_INTERFACE=true

# mDNS (Bonjour) mode:
#   auto     = host if /run/dbus/system_bus_socket is mounted, else internal
#   host     = use the host's avahi-daemon (mount the D-Bus socket in compose)
#   internal = run dbus + avahi inside the container (host must NOT run avahi)
#   none     = no announcement, web UI only
AVAHI_MODE=auto

# SANE "jpeg" option of the xerox_mfp backend. Must stay "no" on the M2070FW:
# with "yes" colour scans fail ("Not a JPEG file") and hang the scanner.
SANE_JPEG=no

# Verbose AirSane logs
DEBUG=false

# Seconds between printer reachability checks; when the printer comes back
# online AirSane rescans automatically. 0 = disabled.
RESCAN_INTERVAL=60
