# Custom AirSane options. To use: copy to config/options.conf and uncomment the
# matching volume in docker-compose.yml. When present, SCANNER_LOCATION is ignored.
#
# Syntax: "<option> <value>"; "device <regex>" starts a per-scanner section.
# SANE options (without leading dashes) are listed by:
#   docker compose exec scanbridge scanimage -A

icon Gnome-scanner.png
location Studio

# Required on the M2070FW: JPEG-compressed colour scans are broken
jpeg no

# macOS applies a 1.8 gamma to eSCL scans; this compensates (1/1.8)
gray-gamma 0.555555
color-gamma 0.555555
